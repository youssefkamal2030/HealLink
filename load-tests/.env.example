# HealLink Load Testing Environment Configuration

# Target Environment (local, staging, production)
ENVIRONMENT=local

# API Base URL (override environment-specific defaults)
# BASE_URL=http://localhost:8080

# Load Test Configuration
# MAX_VUS=100
# DURATION=5m
# RAMP_UP_TIME=1m

# Test Data Configuration
# TEST_USER_COUNT=50
# TEST_DATA_PREFIX=loadtest_

# Authentication Credentials (for staging/production)
# ADMIN_EMAIL=admin@test.heallink.local
# ADMIN_PASSWORD=

# Monitoring and Reporting
# GRAFANA_URL=
# INFLUXDB_URL=
# SLACK_WEBHOOK_URL=

# Database Connection Pool Monitoring
# DB_CONNECTION_STRING=
# DB_MAX_POOL_SIZE=100

# Security
# ALLOW_PRODUCTION_TESTS=false

# CI/CD Configuration
# CI=false
# GITHUB_TOKEN=
